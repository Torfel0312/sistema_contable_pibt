# Site base URL (used for invite/reset email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (run `pnpm supabase:status` to get these values for local dev)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Google Drive integration (optional — attachment uploads via Drive API v3)
GOOGLE_DRIVE_FOLDER_ID="<drive_folder_id>"
# Service account credentials used to authenticate with the Drive API (JWT client)
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Sistema contable PIBT <hola@pibtalcahuano.com>"
# Optional: recipient address. If not set, email sending is skipped.
NOTIFICATION_EMAIL="john.doe@mail.com"
